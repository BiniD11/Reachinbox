generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  googleId        String   @unique
  email           String   @unique
  name            String
  avatar          String?
  slackToken      String?
  slackWebhook    String?
  slackTeamId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  emailSenders    EmailSender[]
  emailJobs       EmailJob[]
}

model EmailSender {
  id        String   @id @default(uuid())
  userId    String
  email     String
  name      String
  host      String
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user_rel  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs EmailJob[]

  @@index([userId])
}

model EmailJob {
  id              String    @id @default(uuid())
  userId          String
  senderId        String
  subject         String
  body            String    @db.Text
  recipients      Json
  scheduledAt     DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  status          EmailJobStatus @default(PENDING)
  bullJobId       String?   @unique
  totalEmails     Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  delayBetween    Int       @default(2000)
  hourlyLimit     Int       @default(200)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender          EmailSender @relation(fields: [senderId], references: [id], onDelete: Cascade)
  emailLogs       EmailLog[]

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model EmailLog {
  id          String   @id @default(uuid())
  jobId       String
  recipient   String
  subject     String
  sentAt      DateTime?
  status      EmailLogStatus @default(PENDING)
  messageId   String?
  error       String?
  createdAt   DateTime @default(now())
  job         EmailJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([recipient])
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PAUSED
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
}
